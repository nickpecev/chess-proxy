# Required when the server is reachable beyond this computer.
# At least 12 characters. This is the password for the proxy, not a Chess.com password.
PROXY_ACCESS_KEY=

# Required in production. At least 24 random characters. Signs the unlock cookie.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public address browsers use. Set this when TLS is terminated in front of Node.
# PUBLIC_ORIGIN=https://chess.example.com

# Listen address. Defaults to 127.0.0.1 outside production, 0.0.0.0 in production.
# BIND_HOST=0.0.0.0
# PORT=8080

# Set to 1 only when a reverse proxy overwrites X-Forwarded-* headers.
# TRUST_PROXY=1
